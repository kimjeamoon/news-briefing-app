# ── 이 파일을 .env 로 복사한 뒤 값을 채우세요 ──────────────────────────
# cp .env.example .env

# [선택] LLM 제공자 선택 (기본값: anthropic)
#   anthropic / gemini / openai 중 하나
LLM_PROVIDER=gemini

# ── anthropic 사용 시 ──
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...
# 사용할 모델 (기본값: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── gemini 사용 시 (LLM_PROVIDER=gemini) ──
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=AIza...
# 사용할 모델 (기본값: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── openai 사용 시 (LLM_PROVIDER=openai) ──
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-proj-...
# 사용할 모델 (기본값: gpt-4o)
OPENAI_MODEL=gpt-4o

# [선택, 권장] 깊은 검색·교차검증용 Tavily 웹 검색 API 키
# https://tavily.com 에서 발급 — 무료 월 1,000회
# 비워 두면 RSS 매체만으로 교차 검증을 수행한다(웹 추가 검색은 생략).
TAVILY_API_KEY=tvly-...

# [선택] 이메일 발송 설정 — 비워 두면 이메일 없이 웹 페이지만 갱신
# 예: Gmail 사용 시 2단계 인증 후 '앱 비밀번호'를 발급해 SMTP_PASSWORD 에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-account@gmail.com
# 받는 사람 (쉼표로 여러 명 지정 가능)
EMAIL_TO=jay@kindhero.co.kr

# [선택] 브리핑 HTML 저장 폴더 (기본값: ./output)
OUTPUT_DIR=./output

# [선택] 웹 서버 바인딩 (기본값: 0.0.0.0:8080)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# [선택] 자동 갱신 시각 — server.py 의 내장 스케줄러가 사용 (기본값: 07:00)
RUN_HOUR=7
RUN_MINUTE=0

# [권장] 시간대 — 한국 시각 기준으로 7시에 돌게 하려면 설정
TZ=Asia/Seoul
